rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function rotatedShiftMarker(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/settings/shiftWrite;
      let after = getAfter(path).data;
      return after.nonce is string && (!exists(path) || get(path).data.nonce != after.nonce);
    }
    match /users/{uid}/settings/shiftWrite {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['nonce'])
        && request.resource.data.nonce is string && request.resource.data.nonce.size() == 36;
    }
    match /users/{uid}/settings/{key} {
      allow read, write: if owner(uid) && key in ['profile', 'payroll', 'adjustments', 'templates', 'clock'];
    }
    match /users/{uid}/shifts/{shiftId} {
      allow read: if owner(uid);
      allow delete: if owner(uid) && rotatedShiftMarker(uid);
      allow create, update: if owner(uid) && rotatedShiftMarker(uid)
        && request.resource.data.id == shiftId
        && request.resource.data.status in ['planned', 'completed', 'active']
        && request.resource.data.start is string && request.resource.data.end is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 120;
    }
  }
}
